@online{bailieFiveSafesPrivacy2026,
  title = {The {{Five Safes}} as a Privacy Context},
  author = {Bailie, James and Gong, Ruobin},
  date = {2026-09-01},
  eprint = {2510.05803},
  eprinttype = {arXiv},
  eprintclass = {cs},
  doi = {10.48550/arXiv.2510.05803},
  abstract = {The Five Safes is a framework used by national statistical offices (NSO) for assessing and managing the disclosure risk of data sharing. It can be understood as a specialization of a roader concept—contextual integrity—to the situation of statistical dissemination by an NSO. We demonstrate this by mapping the five parameters of contextual integrity onto the five dimensions of the Five Safes. We also discuss how each of these two theories can address weaknesses in the other, thereby strengthening them both.},
  url = {http://arxiv.org/abs/2510.05803},
  pubstate = {prepublished},
  keywords = {Computer Science - Computers and Society,Computer Science - Cryptography and Security}
}